{
  "name": "serpent-run",
  "version": "1.0.0",
  "description": "A simple snake survival game for Android and web",
  "private": true,
  "scripts": {
    "web:sync": "node scripts/sync-web-assets.mjs",
    "cap:sync": "npm run web:sync && node scripts/sync-android-assets.mjs",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "android:debug": "cd android && gradlew.bat assembleDebug",
    "android:bundle": "cd android && gradlew.bat bundleRelease"
  },
  "keywords": [
    "snake",
    "game",
    "canvas",
    "capacitor",
    "android"
  ],
  "author": "Muneeb",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
